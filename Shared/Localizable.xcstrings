        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lezioni vanno in un calendario \"Orario personalizzato\", come eventi settimanali fino alla fine delle lezioni. Si aggiorna quando l'orario viene ricalcolato e sparisce se lo archivi o lo elimini."
          }
        }
      }
    },
