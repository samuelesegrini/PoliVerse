      }
    },
    "Le impostazioni raccolte qui si cambiano tutte da Impostazioni, l'icona in alto a destra nella Home." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything set up here can be changed in Settings, the icon at the top right of the Home screen."
